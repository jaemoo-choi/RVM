# Copy to config/paths.local.sh (gitignored) and fill in your paths. config/paths.sh sources it first,
# so every value set here overrides the default.

# Conda: the activate script and the two environments built by ops/setup/setup_{image,video}_elbo.sh
export CONDA_SH=/path/to/anaconda3/etc/profile.d/conda.sh
export CONDA_ENV_IMAGE=/path/to/anaconda3/envs/image_elbo      # SD3.5-M, FLUX.1
export CONDA_ENV_VIDEO=/path/to/anaconda3/envs/video_elbo      # Wan2.1, Wan2.2-A14B, SkyReels-I2V

# HuggingFace cache: where the base models and HF-hosted reward models are downloaded (~200 GB for all models)
export HF_HOME=/path/to/hf_cache

# Weights & Biases entity (team or user name); leave unset to use your default entity
export WANDB_ENTITY=your-entity

# Optional: pip overlay with transformers>=4.49 for the Qwen2.5-VL judge rewards (not used by the default recipes)
# export VS2_OVERLAY=/path/to/vs2_overlay
